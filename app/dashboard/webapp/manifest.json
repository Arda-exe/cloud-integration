{
    "_version": "1.59.0",
    "sap.app": {
        "id": "primepath.dashboard",
        "type": "application",
        "i18n": {
            "bundleUrl": "i18n/i18n.properties",
            "supportedLocales": [""],
            "fallbackLocale": ""
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "dataSources": {
            "peopleService": {
                "uri": "/people/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            },
            "tripsService": {
                "uri": "/trips/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            },
            "airlinesService": {
                "uri": "/airlines/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            },
            "airportsService": {
                "uri": "/airports/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "primepath.dashboard.view.App",
            "type": "XML",
            "id": "app"
        },
        "dependencies": {
            "minUI5Version": "1.136.0",
            "libs": {
                "sap.ui.core": {},
                "sap.m": {},
                "sap.f": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "primepath.dashboard.i18n.i18n",
                    "supportedLocales": [""],
                    "fallbackLocale": ""
                }
            },
            "people": {
                "dataSource": "peopleService",
                "settings": {
                    "autoExpandSelect": true,
                    "operationMode": "Server",
                    "earlyRequests": true
                }
            },
            "trips": {
                "dataSource": "tripsService",
                "settings": {
                    "autoExpandSelect": true,
                    "operationMode": "Server",
                    "earlyRequests": true
                }
            },
            "airlines": {
                "dataSource": "airlinesService",
                "settings": {
                    "autoExpandSelect": true,
                    "operationMode": "Server",
                    "earlyRequests": true
                }
            },
            "airports": {
                "dataSource": "airportsService",
                "settings": {
                    "autoExpandSelect": true,
                    "operationMode": "Server",
                    "earlyRequests": true
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "primepath.dashboard.view",
                "controlId": "content",
                "controlAggregation": "pages",
                "transition": "show",
                "async": true
            },
            "routes": [
                {
                    "name": "overview",
                    "pattern": "",
                    "target": "overview"
                },
                {
                    "name": "employees",
                    "pattern": "employees",
                    "target": "employees"
                },
                {
                    "name": "employee",
                    "pattern": "employees/{userName}",
                    "target": "employee"
                },
                {
                    "name": "airports",
                    "pattern": "airports",
                    "target": "airports"
                },
                {
                    "name": "airportFocus",
                    "pattern": "airports/{iata}",
                    "target": "airports"
                },
                {
                    "name": "trip",
                    "pattern": "employees/{userName}/trips/{tripId}",
                    "target": "trip"
                }
            ],
            "targets": {
                "overview": {
                    "name": "Overview",
                    "viewId": "overview"
                },
                "employees": {
                    "name": "Employees",
                    "viewId": "employees"
                },
                "employee": {
                    "name": "EmployeeDetail",
                    "viewId": "employeeDetail"
                },
                "airports": {
                    "name": "Airports",
                    "viewId": "airports"
                },
                "trip": {
                    "name": "TripDetail",
                    "viewId": "tripDetail"
                }
            }
        }
    }
}
