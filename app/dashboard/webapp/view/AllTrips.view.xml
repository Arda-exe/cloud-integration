<mvc:View
    controllerName="primepath.dashboard.controller.AllTrips"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page
        id="allTripsPage"
        title="{i18n>allTripsTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        backgroundDesign="List">

        <content>
            <Table
                id="allTripsTable"
                items="{view>/groups}"
                growing="true"
                growingThreshold="40"
                busy="{view>/busy}"
                busyIndicatorDelay="200"
                noDataText="{i18n>allTripsNoData}"
                sticky="ColumnHeaders">

                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>allTripsTitle} ({view>/count})" />
                        <ToolbarSpacer />
                        <Button
                            text="{i18n>btnNewTrip}"
                            type="Emphasized"
                            icon="sap-icon://add"
                            visible="{app>/user/isCoordinator}"
                            press=".onCreateTrip" />
                        <Label text="{i18n>approvalFilterLabel}" class="sapUiTinyMarginEnd" />
                        <Select id="approvalFilter" change=".onApprovalFilterChange">
                            <core:Item key="" text="{i18n>filterAll}" />
                            <core:Item key="pending" text="{i18n>appr_pending}" />
                            <core:Item key="approved" text="{i18n>appr_approved}" />
                            <core:Item key="rejected" text="{i18n>appr_rejected}" />
                            <core:Item key="notsubmitted" text="{i18n>approvalNone}" />
                        </Select>
                        <SearchField
                            id="searchField"
                            width="20rem"
                            placeholder="{i18n>employeesSearchPlaceholder}"
                            liveChange=".onSearch" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column width="16rem">
                        <Text text="{i18n>colTrip}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>colTravellers}" />
                    </Column>
                    <Column hAlign="End" width="9rem" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colTotalBudget}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem vAlign="Top">
                        <cells>
                            <VBox>
                                <Link text="{view>tripName}" press=".onTripPress" />
                                <Text text="{view>period}" class="sapUiTinyMarginTop" />
                            </VBox>

                            <VBox items="{view>members}">
                                <HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom">
                                    <Text text="{view>fullName}" width="11rem" class="sapUiTinyMarginEnd" />
                                    <ObjectNumber number="{view>budget}" unit="USD" class="sapUiSmallMarginEnd" />
                                    <ObjectStatus text="{view>statusText}" state="{view>statusState}" class="sapUiSmallMarginEnd" />
                                    <HBox visible="{app>/user/isCoordinator}">
                                        <Button
                                            icon="sap-icon://paper-plane"
                                            tooltip="{i18n>btnSubmit}"
                                            type="Transparent"
                                            enabled="{view>canSubmit}"
                                            press=".onSubmit" />
                                        <Button
                                            icon="sap-icon://accept"
                                            tooltip="{i18n>btnApprove}"
                                            type="Transparent"
                                            enabled="{view>canAct}"
                                            press=".onApprove" />
                                        <Button
                                            icon="sap-icon://decline"
                                            tooltip="{i18n>btnReject}"
                                            type="Transparent"
                                            enabled="{view>canAct}"
                                            press=".onReject" />
                                    </HBox>
                                </HBox>
                            </VBox>

                            <ObjectNumber number="{view>totalBudget}" unit="USD" emphasized="true" />
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>
    </Page>

</mvc:View>
