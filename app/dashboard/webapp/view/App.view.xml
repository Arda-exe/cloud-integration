<mvc:View
    controllerName="primepath.dashboard.controller.App"
    displayBlock="true"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m">

    <VBox height="100vh" renderType="Bare">

        <!-- switch-role = nav-back knop (alleen binnen de app via showNavButton) → launchpad.
             showNavButton/navButtonPressed zijn kern-ShellBar-API (altijd geldig). -->
        <f:ShellBar
            title="{i18n>shellTitle}"
            secondaryTitle="{app>/user/roleLabel}"
            showNavButton="{app>/showChrome}"
            navButtonPressed=".onSwitchRole">
            <f:searchManager>
                <f:SearchManager
                    placeholder="{i18n>globalSearchPlaceholder}"
                    search=".onGlobalSearch" />
            </f:searchManager>
        </f:ShellBar>

        <IconTabHeader
            id="tabHeader"
            visible="{app>/showChrome}"
            selectedKey="overview"
            select=".onTabSelect"
            mode="Inline">
            <items>
                <IconTabFilter key="overview" text="{i18n>tabOverview}" />
                <IconTabFilter key="employees" text="{i18n>tabEmployees}" />
                <IconTabFilter key="airports" text="{i18n>tabAirports}" />
            </items>
        </IconTabHeader>

        <NavContainer id="content">
            <layoutData>
                <FlexItemData growFactor="1" />
            </layoutData>
        </NavContainer>

    </VBox>

</mvc:View>
