<mvc:View
    controllerName="primepath.dashboard.controller.EmployeeDetail"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns="sap.m">

    <Page
        id="employeePage"
        title="{i18n>employeeDetailTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <VBox class="sapUiMediumMarginBegin sapUiMediumMarginTop">
                <Title text="{people>FirstName} {people>LastName}" titleStyle="H1" wrapping="true" />
                <HBox wrap="Wrap" alignItems="Center" class="sapUiSmallMarginTop">
                    <Label text="{i18n>lblEmail}" class="sapUiTinyMarginEnd" />
                    <Text text="{path: 'people>Emails', targetType: 'any', formatter: '.formatEmails'}" class="sapUiMediumMarginEnd" />
                    <Label text="{i18n>lblCity}" class="sapUiTinyMarginEnd" />
                    <Text text="{path: 'people>AddressInfo', targetType: 'any', formatter: '.formatCity'}" class="sapUiMediumMarginEnd" />
                    <Label text="{i18n>colTeam}" class="sapUiTinyMarginEnd" visible="{= !!${detail>/team} }" />
                    <Text text="{detail>/team}" class="sapUiMediumMarginEnd" visible="{= !!${detail>/team} }" />
                    <Label text="{i18n>colCompany}" class="sapUiTinyMarginEnd" visible="{= !!${detail>/company} }" />
                    <Text text="{detail>/company}" visible="{= !!${detail>/company} }" />
                </HBox>
            </VBox>

            <FlexBox wrap="Wrap" class="sapUiSmallMarginBegin sapUiSmallMarginTop">
                <GenericTile header="{i18n>countTotalTrips}" class="sapUiTinyMargin">
                    <TileContent>
                        <NumericContent value="{detail>/counts/total}" icon="sap-icon://travel-itinerary" withMargin="false" />
                    </TileContent>
                </GenericTile>
                <GenericTile header="{i18n>countUpcoming}" class="sapUiTinyMargin">
                    <TileContent>
                        <NumericContent value="{detail>/counts/upcoming}" icon="sap-icon://appointment-2" withMargin="false" />
                    </TileContent>
                </GenericTile>
                <GenericTile header="{i18n>countCompleted}" class="sapUiTinyMargin">
                    <TileContent>
                        <NumericContent value="{detail>/counts/completed}" icon="sap-icon://complete" withMargin="false" />
                    </TileContent>
                </GenericTile>
            </FlexBox>

            <Table
                id="tripsTable"
                items="{detail>/trips}"
                busy="{detail>/busy}"
                busyIndicatorDelay="200"
                noDataText="{i18n>tripsNoData}"
                class="sapUiSmallMarginTop sapUiMediumMarginBottom">

                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>tripsTitle}" />
                        <ToolbarSpacer />
                        <Button
                            icon="sap-icon://map"
                            text="{i18n>btnLocateOnDate}"
                            press=".onOpenLocation" />
                        <Button text="{i18n>periodAll}" app:period="all" press=".onPresetPress"
                            type="{= ${detail>/preset} === 'all' ? 'Emphasized' : 'Transparent' }" />
                        <Button text="{i18n>periodLastMonth}" app:period="month" press=".onPresetPress"
                            type="{= ${detail>/preset} === 'month' ? 'Emphasized' : 'Transparent' }" />
                        <Button text="{i18n>periodLast3Months}" app:period="quarter" press=".onPresetPress"
                            type="{= ${detail>/preset} === 'quarter' ? 'Emphasized' : 'Transparent' }" />
                        <Button text="{i18n>periodLastYear}" app:period="year" press=".onPresetPress"
                            type="{= ${detail>/preset} === 'year' ? 'Emphasized' : 'Transparent' }" />
                        <DateRangeSelection
                            id="tripsRange"
                            width="18rem"
                            placeholder="{i18n>tripsRangePlaceholder}"
                            change=".onDateRangeChange" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="{i18n>colTrip}" /></Column>
                    <Column><Text text="{i18n>colPeriod}" /></Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colBudget}" />
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>colDescription}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Bron" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" press=".onTripPress">
                        <cells>
                            <ObjectIdentifier title="{detail>Name}" />
                            <Text text="{parts: ['detail>StartsAt', 'detail>EndsAt'], formatter: '.formatPeriod'}" />
                            <ObjectNumber number="{detail>Budget}" unit="USD" />
                            <Text text="{detail>Description}" maxLines="2" />
                            <ObjectStatus
                                text="{= ${detail>_isOwn} ? 'Eigen' : 'TripPin' }"
                                state="{= ${detail>_isOwn} ? 'Success' : 'None' }" />
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>
    </Page>

</mvc:View>