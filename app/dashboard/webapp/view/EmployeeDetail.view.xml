<mvc:View
    controllerName="primepath.dashboard.controller.EmployeeDetail"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="employeePage"
        title="{i18n>employeeDetailTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <ObjectHeader
                title="{people>FirstName} {people>LastName}"
                intro="{people>UserName}">
                <attributes>
                    <ObjectAttribute
                        title="{i18n>lblEmail}"
                        text="{path: 'people>Emails', targetType: 'any', formatter: '.formatEmails'}" />
                </attributes>
            </ObjectHeader>

            <Title
                text="Trips"
                class="sapUiMediumMarginBegin sapUiSmallMarginTop" />

            <List
                id="tripsList"
                items="{tripData>/trips}"
                noDataText="Geen trips gevonden">
                <StandardListItem
                    title="{tripData>Name}"
                    description="{tripData>Description}"
                    info="{path: 'tripData>StartsAt', formatter: '.formatDate'} - {path: 'tripData>EndsAt', formatter: '.formatDate'}"
                    infoState="None" />
            </List>

        </content>

    </Page>

</mvc:View>