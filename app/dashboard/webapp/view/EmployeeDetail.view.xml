<mvc:View
    controllerName="primepath.dashboard.controller.EmployeeDetail"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="employeePage"
        title="Employee Detail"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <ObjectHeader
                title="{people>FirstName} {people>LastName}"
                intro="{people>UserName}">
                <attributes>
                    <ObjectAttribute
                        title="Email"
                        text="{path: 'people>Emails', targetType: 'any', formatter: '.formatEmails'}" />
                    <ObjectAttribute
                        title="{i18n>lblCity}"
                        text="{path: 'people>AddressInfo', targetType: 'any', formatter: '.formatCity'}" />
                </attributes>
            </ObjectHeader>

            <Panel headerText="{i18n>locationTitle}" class="sapUiSmallMargin">
                <content>
                    <HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMargin">
                        <DatePicker
                            id="locationDate"
                            width="12rem"
                            placeholder="{i18n>locationDatePlaceholder}"
                            change=".onLocationDateChange"
                            class="sapUiSmallMarginEnd" />
                        <Text text="{detail>/locationText}" />
                    </HBox>
                </content>
            </Panel>

            <Table
                id="tripsTable"
                items="{detail>/trips}"
                busy="{detail>/busy}"
                busyIndicatorDelay="200"
                noDataText="{i18n>tripsNoData}">

                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>tripsTitle}" />
                        <ToolbarSpacer />
                        <DateRangeSelection
                            id="tripsRange"
                            width="18rem"
                            placeholder="{i18n>tripsRangePlaceholder}"
                            change=".onDateRangeChange" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="{i18n>colTrip}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>colPeriod}" />
                    </Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colBudget}" />
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>colDescription}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" press=".onTripPress">
                        <cells>
                            <ObjectIdentifier title="{detail>Name}" />
                            <Text text="{parts: ['detail>StartsAt', 'detail>EndsAt'], formatter: '.formatPeriod'}" />
                            <ObjectNumber number="{detail>Budget}" unit="USD" />
                            <Text text="{detail>Description}" maxLines="2" />
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>

            <List
                id="tripsList"
                items="{tripData>/trips}"
                noDataText="Geen trips gevonden">
                <StandardListItem
                    title="{tripData>Name}"
                    description="{tripData>Description}"
                    info="{path: 'tripData>StartsAt', formatter: '.formatDate'} - {path: 'tripData>EndsAt', formatter: '.formatDate'}"
                    infoState="None" />
            </List>
        </content>
    </Page>

</mvc:View>