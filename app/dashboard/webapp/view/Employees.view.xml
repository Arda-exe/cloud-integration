<mvc:View
    controllerName="primepath.dashboard.controller.Employees"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page showHeader="false" backgroundDesign="List">
        <content>
            <Table
                id="employeesTable"
                items="{view>/people}"
                growing="true"
                growingThreshold="20"
                busy="{view>/busy}"
                busyIndicatorDelay="200"
                noDataText="{i18n>employeesNoData}"
                sticky="ColumnHeaders">

                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>employeesTableTitle} ({view>/count})" />
                        <Button
                            text="{i18n>btnAllTrips}"
                            type="Emphasized"
                            icon="sap-icon://travel-itinerary"
                            press=".onAllTrips" />
                        <ToolbarSpacer />
                        <Label text="{i18n>statusFilterLabel}" class="sapUiTinyMarginEnd" />
                        <Select id="statusFilter" change=".onStatusChange">
                            <core:Item key="" text="{i18n>statusAll}" />
                            <core:Item key="traveling" text="{i18n>statusTraveling}" />
                            <core:Item key="upcoming" text="{i18n>statusUpcoming}" />
                            <core:Item key="available" text="{i18n>statusAvailable}" />
                        </Select>
                        <Label text="{i18n>teamFilterLabel}" class="sapUiTinyMarginEnd" />
                        <Select id="teamFilter" items="{view>/teamOptions}" change=".onTeamChange">
                            <core:Item key="{view>key}" text="{view>text}" />
                        </Select>
                        <Label text="{i18n>companyFilterLabel}" class="sapUiTinyMarginEnd" />
                        <Select id="companyFilter" items="{view>/companyOptions}" change=".onCompanyChange">
                            <core:Item key="{view>key}" text="{view>text}" />
                        </Select>
                        <SearchField
                            id="searchField"
                            width="20rem"
                            placeholder="{i18n>employeesSearchPlaceholder}"
                            liveChange=".onSearch" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="{i18n>colName}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>colStatus}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colTeam}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colCompany}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colUserName}" />
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>colEmail}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" press=".onEmployeePress">
                        <cells>
                            <ObjectIdentifier title="{view>FirstName} {view>LastName}" />
                            <ObjectStatus text="{view>statusText}" state="{view>statusState}" />
                            <Text text="{view>team}" />
                            <Text text="{view>company}" />
                            <Text text="{view>UserName}" />
                            <Text text="{path: 'view>Emails', targetType: 'any', formatter: '.formatEmails'}" />
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>
    </Page>

</mvc:View>
