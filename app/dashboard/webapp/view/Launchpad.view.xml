<mvc:View
    controllerName="primepath.dashboard.controller.Launchpad"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns="sap.m">

    <!-- PrimePath Travel welkom/rol-kiezer (POST-login). De tegels tonen welke rollen je BEZIT
         (app>/user/has*); lokaal (cds watch) tonen we alle drie als dev-rol-switcher (app>/isLocal).
         Een klik "speelt" die rol (Component.pickRole → actAsRole/loginAs) en scopet de app; de
         tab-balk verschijnt pas binnen de app (App.view bindt IconTabHeader visible aan
         app>/showChrome). Op BTP gebeurt de XSUAA-login al vóór dit scherm (approuter). -->
    <Page showHeader="false" backgroundDesign="List">
        <content>
            <VBox alignItems="Center" justifyContent="Center"
                class="sapUiLargeMarginTop sapUiLargeMarginBottom">

                <!-- branding + wie je bent -->
                <core:Icon src="sap-icon://flight" size="2.5rem"
                    class="sapUiSmallMarginBottom" />
                <Title text="{i18n>shellTitle}" level="H1" titleStyle="H1" textAlign="Center" />
                <Text text="{= ${i18n>loggedInAs} + ' ' + ${app>/user/id} }"
                    visible="{= !!${app>/user/id} }"
                    textAlign="Center" class="sapUiTinyMarginTop sapUiMediumMarginBottom" />

                <!-- één tegel per rol die de gebruiker bezit (lokaal: altijd alle drie) -->
                <FlexBox wrap="Wrap" justifyContent="Center" alignItems="Center">
                    <GenericTile class="sapUiSmallMargin" frameType="TwoByOne"
                        visible="{= ${app>/isLocal} || ${app>/user/hasCoordinator} }"
                        header="{i18n>roleTravelCoordinatorTitle}"
                        subheader="{i18n>roleTravelCoordinatorDesc}"
                        app:role="TravelCoordinator"
                        press=".onSelectRole">
                        <TileContent>
                            <ImageContent src="sap-icon://approvals" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile class="sapUiSmallMargin" frameType="TwoByOne"
                        visible="{= ${app>/isLocal} || ${app>/user/hasTeamLead} }"
                        header="{i18n>roleTeamLeadTitle}"
                        subheader="{i18n>roleTeamLeadDesc}"
                        app:role="TeamLead"
                        press=".onSelectRole">
                        <TileContent>
                            <ImageContent src="sap-icon://manager" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile class="sapUiSmallMargin" frameType="TwoByOne"
                        visible="{= ${app>/isLocal} || ${app>/user/hasHR} }"
                        header="{i18n>roleHRTitle}"
                        subheader="{i18n>roleHRDesc}"
                        app:role="HR"
                        press=".onSelectRole">
                        <TileContent>
                            <ImageContent src="sap-icon://employee" />
                        </TileContent>
                    </GenericTile>
                </FlexBox>

                <!-- echte sign-out (alleen BTP, ná login) -->
                <Link text="{i18n>btnSignOut}" press=".onSignOut"
                    visible="{= !${app>/isLocal} }" class="sapUiMediumMarginTop" />
            </VBox>
        </content>
    </Page>

</mvc:View>
