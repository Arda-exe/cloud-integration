<mvc:View
    controllerName="primepath.dashboard.controller.TripDetail"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page
        id="tripPage"
        title="{i18n>tripDetailTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        busy="{trip>/busy}"
        busyIndicatorDelay="200">

        <content>
            <!-- number = GECOMBINEERD budget (som over alle reizigers) → identiek vanuit elke kopie -->
            <ObjectHeader
                title="{trip>/trip/Name}"
                number="{trip>/totalBudget}"
                numberUnit="USD"
                responsive="true">
                <attributes>
                    <ObjectAttribute title="{i18n>lblPeriod}" text="{trip>/periodText}" />
                </attributes>
            </ObjectHeader>

            <FlexBox wrap="Wrap" alignItems="Stretch" class="sapUiSmallMarginTop">
            <Panel headerText="{i18n>routeTitle}" class="sapUiSmallMarginBeginEnd" visible="{trip>/route/has}">
                <layoutData>
                    <FlexItemData growFactor="2" baseSize="42rem" />
                </layoutData>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <!-- volledig traject: alle stops in volgorde (retour wordt zichtbaar) -->
                        <FlexBox wrap="Wrap" justifyContent="Center" alignItems="Center"
                            class="sapUiSmallMarginBottom" items="{trip>/route/stops}">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://flight" size="1.5rem"
                                    visible="{trip>showArrow}"
                                    class="sapUiMediumMarginBegin sapUiMediumMarginEnd" />
                                <VBox alignItems="Center">
                                    <Title text="{trip>iata}" level="H2" />
                                    <Text text="{trip>name}" textAlign="Center" />
                                </VBox>
                            </HBox>
                        </FlexBox>

                        <!-- één feiten-kaart per unieke luchthaven -->
                        <FlexBox wrap="Wrap" justifyContent="Center" items="{trip>/route/airports}">
                            <f:Card width="20rem" class="sapUiSmallMargin">
                                <f:header>
                                    <card:Header title="{trip>name}" subtitle="{trip>iata}" iconSrc="sap-icon://map-3" />
                                </f:header>
                                <f:content>
                                    <VBox class="sapUiSmallMargin">
                                        <HBox class="sapUiTinyMarginBottom">
                                            <Label text="{i18n>lblCity}" width="9rem" />
                                            <Text text="{trip>city}" />
                                        </HBox>
                                    </VBox>
                                </f:content>
                            </f:Card>
                        </FlexBox>
                    </VBox>
                </content>
            </Panel>

            <!-- geen vluchten in TripPin voor deze trip → nette lege staat i.p.v. een
                 verdwijnende routeblok / leeg gat (alleen tonen zodra het laden klaar is) -->
            <Panel headerText="{i18n>routeTitle}" class="sapUiSmallMarginBeginEnd"
                visible="{= !${trip>/route/has} &amp;&amp; !${trip>/flightsBusy} }">
                <layoutData>
                    <FlexItemData growFactor="2" baseSize="42rem" />
                </layoutData>
                <content>
                    <VBox alignItems="Center" justifyContent="Center" height="12rem" class="sapUiMediumMargin">
                        <core:Icon src="sap-icon://flight" size="3rem" class="sapUiMediumMarginBottom" />
                        <Title text="{i18n>noFlightsTitle}" level="H3" textAlign="Center" />
                        <Text text="{i18n>noFlightsText}" textAlign="Center" class="sapUiTinyMarginTop" />
                    </VBox>
                </content>
            </Panel>

            <!-- reizigers met elk hun EIGEN budget + goedkeuringsstatus; klik → hun detail -->
            <Panel headerText="{i18n>tripBudgetsTitle}" class="sapUiSmallMarginBeginEnd"
                visible="{= ${trip>/members}.length > 0 }">
                <layoutData>
                    <FlexItemData growFactor="1" baseSize="24rem" />
                </layoutData>
                <content>
                    <Table items="{trip>/members}">
                        <columns>
                            <Column><Text text="{i18n>colEmployee}" /></Column>
                            <Column hAlign="End"><Text text="{i18n>colBudget}" /></Column>
                            <Column><Text text="{i18n>colStatus}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Link text="{trip>name}" press=".onCoTravellerPress" />
                                    <ObjectNumber number="{trip>budget}" unit="USD" />
                                    <ObjectStatus text="{trip>statusText}" state="{trip>statusState}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>
            </FlexBox>

            <Panel headerText="{i18n>tripInfoTitle}" class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Text text="{trip>/trip/Description}" />
                    </VBox>
                </content>
            </Panel>

            <Panel headerText="{i18n>flightsTitle}" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"
                visible="{= ${trip>/route/has} || ${trip>/flightsBusy} }">
                <content>
                    <Table
                        id="flightsTable"
                        items="{trip>/flights}"
                        busy="{trip>/flightsBusy}"
                        busyIndicatorDelay="200"
                        noDataText="{i18n>flightsNoData}"
                        sticky="ColumnHeaders">

                        <columns>
                            <Column>
                                <Text text="{i18n>colFlight}" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="{i18n>colFrom}" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="{i18n>colTo}" />
                            </Column>
                            <Column minScreenWidth="Desktop" demandPopin="true">
                                <Text text="{i18n>colDeparture}" />
                            </Column>
                            <Column minScreenWidth="Desktop" demandPopin="true">
                                <Text text="{i18n>colArrival}" />
                            </Column>
                            <Column width="5rem" hAlign="End">
                                <Text text="{i18n>colSeat}" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem vAlign="Middle">
                                <cells>
                                    <ObjectIdentifier title="{trip>flightTitle}" text="{trip>airlineName}" />
                                    <Link text="{trip>fromName} ({trip>fromIata})" press=".onFromPress" />
                                    <Link text="{trip>toName} ({trip>toIata})" press=".onToPress" />
                                    <Text text="{trip>departure}" />
                                    <Text text="{trip>arrival}" />
                                    <Text text="{trip>seat}" />
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                </content>
            </Panel>
        </content>

    </Page>

</mvc:View>
