<mvc:View
    controllerName="primepath.dashboard.controller.App"
    displayBlock="true"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m">

    <VBox height="100vh" renderType="Bare">

        <!-- switch-role = nav-back knop (alleen binnen de app via showNavButton) → launchpad.
             showNavButton/navButtonPressed zijn kern-ShellBar-API (altijd geldig). -->
        <f:ShellBar
            id="shellBar"
            title="{i18n>shellTitle}"
            secondaryTitle="{app>/user/roleLabel}"
            showNavButton="{app>/showChrome}"
            navButtonPressed=".onSwitchRole">
            <f:searchManager>
                <f:SearchManager
                    placeholder="{i18n>globalSearchPlaceholder}"
                    search=".onGlobalSearch" />
            </f:searchManager>
            <!-- kleine indicator van de ingelogde gebruiker (initialen + tooltip met user-id);
                 alleen binnen de app, niet op de launchpad -->
            <f:profile>
                <Avatar
                    initials="{app>/user/initials}"
                    displaySize="XS"
                    visible="{app>/showChrome}"
                    tooltip="{= ${i18n>loggedInAs} + ' ' + ${app>/user/id} }" />
            </f:profile>
        </f:ShellBar>

        <IconTabHeader
            id="tabHeader"
            visible="{app>/showChrome}"
            selectedKey="overview"
            select=".onTabSelect"
            mode="Inline">
            <!-- tabs per rol: HR ziet Overview (rapportage), TeamLead ziet Employees, Coordinator
                 ziet alles; Airports is voor iedereen. De route-guard in App.controller dwingt
                 dit ook op hash-niveau af (een verborgen tab is anders nog via de URL bereikbaar). -->
            <items>
                <IconTabFilter key="overview" text="{i18n>tabOverview}"
                    visible="{= ${app>/user/isCoordinator} || ${app>/user/isHR} }" />
                <IconTabFilter key="employees" text="{i18n>tabEmployees}"
                    visible="{= ${app>/user/isCoordinator} || ${app>/user/isTeamLead} }" />
                <IconTabFilter key="airports" text="{i18n>tabAirports}" />
            </items>
        </IconTabHeader>

        <NavContainer id="content">
            <layoutData>
                <FlexItemData growFactor="1" />
            </layoutData>
        </NavContainer>

    </VBox>

</mvc:View>
