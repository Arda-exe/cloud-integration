{
    "welcomeFile": "/secure/index.html",
    "authenticationMethod": "route",
    "logout": {
        "logoutEndpoint": "/logout",
        "logoutPage": "/"
    },
    "routes": [
        {
            "source": "^/secure/(.*)$",
            "target": "/dashboard/webapp/$1",
            "destination": "srv-api",
            "authenticationType": "xsuaa"
        },
        {
            "source": "^/(user|people|trips|airlines|airports)(/.*)?$",
            "destination": "srv-api",
            "authenticationType": "xsuaa",
            "csrfProtection": false
        },
        {
            "source": "^/dashboard/webapp/(.*)$",
            "destination": "srv-api",
            "authenticationType": "xsuaa"
        }
    ]
}
