{
  "name": "primepath-travel",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^1",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.13.0",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "coordinator": { "password": "test", "roles": ["TravelCoordinator"] },
          "teamlead": { "password": "test", "roles": ["TeamLead"] },
          "hr": { "password": "test", "roles": ["HR"] },
          "super": { "password": "test", "roles": ["TravelCoordinator", "TeamLead", "HR"] }
        }
      },
      "TripPin": {
        "kind": "odata-v4",
        "model": "srv/external/TripPin",
        "credentials": {
          "url": "https://services.odata.org/V4/TripPinService"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      }
    }
  }
}